/* Generated by fw-automation-agent. Do not edit by hand.
 * Target: {{ mcu.name }} @ {{ f_cpu_hz }} Hz
 *
 * Reads every sensor once per loop and reports over UART at {{ uart_baud }} baud.
 * A failed read prints an explicit error code -- no placeholder value is ever
 * emitted in place of a real measurement.
 *
 * Output lines look like:
{%- for sensor in sensors %}
{%- if sensor.driver_kind == 'single_wire' %}
 *   {{ sensor.name }} T=23.5C RH=45.2%
{%- elif sensor.driver_kind == 'ultrasonic' %}
 *   {{ sensor.name }} d=1245mm
{%- else %}
 *   {{ sensor.name }} adc=512 ({{ '1' }}234mV)
{%- endif %}
{%- endfor %}
 *   <name> ERR=<code>
 */
#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>

#include "config.h"
#include "sensor.h"
#include "uart.h"
{%- for sensor in sensors %}
#include "{{ sensor.symbol | lower }}.h"
{%- endfor %}

static void report_error(const char *name, sensor_status_t status)
{
    uart_write_string(name);
    uart_write_string(" ERR=");
    uart_write_u16((uint16_t)status);
    uart_write_string("\r\n");
}

static void board_init(void)
{
    uart_init();
{%- for sensor in sensors %}
    {{ sensor.symbol | lower }}_init();
{%- endfor %}
}

int main(void)
{
    sensor_status_t status = SENSOR_OK;
{%- if has_single_wire %}
    int16_t temp_dc = 0;
    uint16_t rh_dpm = 0;
{%- endif %}
{%- if has_simple_value %}
    uint16_t reading = 0;
{%- endif %}
{%- if has_adc %}
    uint16_t millivolts = 0;
{%- endif %}

    board_init();
    uart_write_string("\r\n" MCU_NAME " firmware up\r\n");

    for (;;) {
{%- for sensor in sensors %}
{%- if sensor.driver_kind == 'single_wire' %}
        status = {{ sensor.symbol | lower }}_read_all(&temp_dc, &rh_dpm);
        if (status == SENSOR_OK) {
            uart_write_string("{{ sensor.name }} T=");
            uart_write_tenths(temp_dc);
            uart_write_string("C RH=");
            uart_write_tenths((int16_t)rh_dpm);
            uart_write_string("%\r\n");
        } else {
            report_error("{{ sensor.name }}", status);
        }
{%- elif sensor.driver_kind == 'ultrasonic' %}
        status = {{ sensor.symbol | lower }}_read_mm(&reading);
        if (status == SENSOR_OK) {
            uart_write_string("{{ sensor.name }} d=");
            uart_write_u16(reading);
            uart_write_string("mm\r\n");
        } else {
            report_error("{{ sensor.name }}", status);
        }
{%- else %}
        status = {{ sensor.symbol | lower }}_read(&reading);
        if (status == SENSOR_OK) {
            uart_write_string("{{ sensor.name }} adc=");
            uart_write_u16(reading);
            if ({{ sensor.symbol | lower }}_read_mv(&millivolts) == SENSOR_OK) {
                uart_write_string(" (");
                uart_write_u16(millivolts);
                uart_write_string("mV)");
            }
            uart_write_string("\r\n");
        } else {
            report_error("{{ sensor.name }}", status);
        }
{%- endif %}
{%- if not loop.last %}
        _delay_ms(SENSOR_SETTLE_MS);
{%- endif %}
{%- endfor %}
        _delay_ms(LOOP_PERIOD_MS);
    }

    return 0;
}
