/* Generated by fw-automation-agent. Do not edit by hand.
 * Target: {{ mcu.name }} @ {{ f_cpu_hz }} Hz
 *
 * Every sensor read returns a sensor_status_t; a failed read leaves the
 * caller's value untouched rather than substituting a placeholder.
 */
#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>

#include "config.h"
#include "sensor.h"
{%- for sensor in sensors %}
#include "{{ sensor.symbol | lower }}.h"
{%- endfor %}

static void board_init(void)
{
{%- for sensor in sensors %}
    {{ sensor.symbol | lower }}_init();
{%- endfor %}
}

int main(void)
{
    uint16_t reading = 0;
    sensor_status_t status = SENSOR_OK;

    board_init();

    for (;;) {
{%- for sensor in sensors %}
        status = {{ sensor.symbol | lower }}_read(&reading);
        if (status == SENSOR_OK) {
            /* TODO: publish the {{ sensor.name }} reading (UART/log/radio). */
            (void)reading;
        } else {
            /* TODO: surface the failure for {{ sensor.name }}. */
            (void)status;
        }
{%- if not loop.last %}
        _delay_ms(SENSOR_SETTLE_MS);
{%- endif %}
{%- endfor %}
        _delay_ms(LOOP_PERIOD_MS);
    }

    return 0;
}
