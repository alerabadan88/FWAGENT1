/*
 * Generated by fw-automation-agent.
 *
 * Note what is absent: there are no register writes here, and no driver. Each
 * device is fetched by its devicetree node and read through Zephyr's sensor
 * API, so the code that knows how a {{ (sensors | first).resolution.part if sensors else "part" }}
 * works was written by someone with its datasheet -- not recalled.
 */

#include <zephyr/kernel.h>
#include <zephyr/device.h>
#include <zephyr/devicetree.h>
#include <zephyr/logging/log.h>
{% if sensors %}
#include <zephyr/drivers/sensor.h>
{% endif %}
{% if buttons %}
#include <zephyr/input/input.h>
{% endif %}
{% if uart_nodes %}
#include <zephyr/modem/modem_pipe.h>
#include <zephyr/drivers/gnss.h>
{% endif %}

LOG_MODULE_REGISTER({{ board }}, CONFIG_LOG_DEFAULT_LEVEL);

{% for node in sensors %}
static const struct device *const {{ node.label }} = DEVICE_DT_GET(DT_NODELABEL({{ node.label }}));
{% endfor %}

{% if buttons %}
static void on_input(struct input_event *event, void *user_data)
{
	ARG_UNUSED(user_data);
	LOG_INF("input code %u value %d", event->code, event->value);
}
{% for node in buttons %}
INPUT_CALLBACK_DEFINE(DEVICE_DT_GET(DT_NODELABEL({{ node.label }})), on_input, NULL);
{% endfor %}
{% endif %}

{% if uart_nodes %}
{% for node in uart_nodes %}
static void {{ node.label }}_fix(const struct device *dev, const struct gnss_data *data)
{
	ARG_UNUSED(dev);

	if (data->info.fix_status == GNSS_FIX_STATUS_NO_FIX) {
		LOG_INF("{{ node.resolution.part }}: no fix yet");
		return;
	}

	LOG_INF("{{ node.resolution.part }}: lat %lld nano-deg, lon %lld nano-deg, %u satellites",
		data->nav_data.latitude, data->nav_data.longitude,
		data->info.satellites_cnt);
}
GNSS_DATA_CALLBACK_DEFINE(DEVICE_DT_GET(DT_NODELABEL({{ node.label }})), {{ node.label }}_fix);
{% endfor %}
{% endif %}

{% if sensors %}
static int read_one(const struct device *dev, const char *name)
{
	struct sensor_value value;
	int err;

	err = sensor_sample_fetch(dev);
	if (err) {
		/* Reported, not swallowed: a sensor that stops answering must not
		 * look like a sensor reporting its last value forever. */
		LOG_ERR("%s: sample fetch failed (%d)", name, err);
		return err;
	}

	err = sensor_channel_get(dev, SENSOR_CHAN_AMBIENT_TEMP, &value);
	if (err) {
		LOG_ERR("%s: channel read failed (%d)", name, err);
		return err;
	}

	LOG_INF("%s: %d.%06d C", name, value.val1, value.val2);
	return 0;
}
{% endif %}

int main(void)
{
	LOG_INF("{{ board_title }} starting");

{% for node in sensors %}
	if (!device_is_ready({{ node.label }})) {
		/* The driver bound but the device did not answer. On I2C that is
		 * usually the address or the pull-ups; on a one-wire part it is
		 * usually the pin. Both were answered by hand, so both are worth
		 * re-checking against the board. */
		LOG_ERR("{{ node.resolution.part }} is not ready");
		return -ENODEV;
	}
{% endfor %}

	while (1) {
{% for node in sensors %}
		(void)read_one({{ node.label }}, "{{ node.resolution.part }}");
{% endfor %}
		k_sleep(K_MSEC({{ loop_period_ms | default(2000) }}));
	}

	return 0;
}
