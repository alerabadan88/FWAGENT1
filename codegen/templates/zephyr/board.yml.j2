# Generated by fw-automation-agent from a schematic and an interview.
board:
  name: {{ board }}
  full_name: {{ board_title }}
  vendor: {{ soc.vendor }}
  socs:
    - name: {{ soc.name }}
{% if cpucluster %}
      # A multi-core SoC. Without this qualifier west rejects the board as
      # ambiguous, from inside boards.cmake, without saying what is missing.
      cpuclusters:
        - name: {{ cpucluster }}
{% endif %}
