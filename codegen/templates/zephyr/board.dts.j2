/*
 * {{ board_title }}
 *
 * Generated by fw-automation-agent from a schematic and an interview.
 *
 * Every `compatible` below was checked against the binding file that declares
 * it, in {{ binding_source }}. No compatible here was chosen because it looked
 * close to a part number: a driver bound to the wrong device initialises
 * cleanly and reports numbers that are wrong.
 *
 * What this file asserts, and where it came from:
 *   - which peripherals exist ...... {{ soc.name }} SoC support in Zephyr
 *   - what is wired to them ........ the schematic, or answered by hand
 *   - which driver each part uses .. Zephyr {{ zephyr_ref }} bindings
 */

/dts-v1/;
#include <{{ soc.dtsi_include }}>

/* The macros used below come from these, not from the SoC include. Relying on
 * the SoC .dtsi to pull them in happens to work on some vendors and not on
 * others, and the failure is a preprocessor error at build time. */
#include <zephyr/dt-bindings/gpio/gpio.h>
{% if buttons %}
#include <zephyr/dt-bindings/input/input-event-codes.h>
{% endif %}
{% if i2c_nodes %}
#include <zephyr/dt-bindings/i2c/i2c.h>
{% endif %}

/ {
	model = "{{ board_title }}";
	compatible = "{{ soc.vendor }},{{ board }}";

	chosen {
		zephyr,console = &{{ soc.uart_label }};
		zephyr,shell-uart = &{{ soc.uart_label }};
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

{% for node in root_nodes %}
{% if node.compatible == "gpio-keys" %}
	{{ node.label }}: {{ node.label }} {
		compatible = "gpio-keys";
		{{ node.label }}_key: {{ node.label }}_key {
			/* Active level and pull came from the interview: neither is
			 * discoverable, and both fail silently when guessed. */
			gpios = {{ gpio_spec(pin_of(node), "(GPIO_ACTIVE_LOW | GPIO_PULL_UP)") }};
			label = "{{ node.label }}";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
{% else %}
	{{ node.label }}: {{ node.label }} {
		compatible = "{{ node.compatible }}";
		dio-gpios = {{ gpio_spec(pin_of(node), "(GPIO_PULL_UP | GPIO_ACTIVE_LOW)") }};
		status = "okay";
	};
{% endif %}

{% endfor %}
};

{% if i2c_nodes %}
&{{ soc.i2c_label }} {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

{% for node in i2c_nodes %}
	{{ node.label }}: {{ node.label }}@{{ node.properties["reg"] | replace("<0x", "") | replace(">", "") }} {
		compatible = "{{ node.compatible }}";
		reg = {{ node.properties["reg"] }};
		status = "okay";
	};
{% endfor %}
};
{% endif %}

{% if uart_nodes %}
{% for node in uart_nodes %}
/*
 * {{ node.resolution.part }} on a serial port of its own. It cannot share the
 * console UART: two devices on one peripheral interleave and both are lost.
 */
&uart1 {
	status = "okay";
	current-speed = <9600>;

	{{ node.label }}: {{ node.label }} {
		compatible = "{{ node.compatible }}";
		status = "okay";
	};
};
{% endfor %}
{% endif %}
