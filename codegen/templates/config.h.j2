/* Generated by fw-automation-agent. Do not edit by hand.
 * Target: {{ mcu.name }} ({{ mcu.family }})
 */
#ifndef CONFIG_H
#define CONFIG_H

/* Identity, so a device on a bench can be matched to the build that produced
 * it -- a prerequisite for knowing whether a given unit carries a fix. */
#define FIRMWARE_VERSION "{{ firmware_version }}"
#define BUILD_ID         "{{ build_id }}"

#define MCU_NAME        "{{ mcu.name }}"
#define MCU_FAMILY      "{{ mcu.family }}"
#define F_CPU           {{ f_cpu_hz }}UL
#define MCU_FLASH_KB    {{ mcu.flash_kb | int }}
#define MCU_RAM_KB      {{ mcu.ram_kb | int }}
#define SUPPLY_VOLTAGE_MV {{ (mcu.voltage * 1000) | int }}

#define SENSOR_COUNT    {{ sensors | length }}
#define LOOP_PERIOD_MS  {{ loop_period_ms }}
/* Gap between consecutive sensor reads: the HC-SR04 needs its previous
 * burst to decay before the next trigger. */
#define SENSOR_SETTLE_MS {{ sensor_settle_ms }}

/* USART0: {{ uart_baud }} baud requested, {{ uart_actual_baud }} actual ({{ uart_error_percent }} % error). */
#define UART_BAUD       {{ uart_baud }}
#define UART_UBRR       {{ uart_ubrr }}

/* Watchdog: {{ watchdog_timeout_ms }} ms, against a worst-case loop of about
 * {{ watchdog_budget_ms }} ms. */
#define WATCHDOG_TIMEOUT_MS {{ watchdog_timeout_ms }}

{% for sensor in sensors %}
/* {{ sensor.name }} - {{ sensor.type }} over {{ sensor.interface.value }} */
{%- for role, pin in sensor.resolved_pins.items() %}
#define {{ sensor.symbol }}_{{ role | upper }}_PORT   {{ pin.port_register }}
#define {{ sensor.symbol }}_{{ role | upper }}_DDR    {{ pin.ddr_register }}
#define {{ sensor.symbol }}_{{ role | upper }}_PIN    {{ pin.input_register }}
#define {{ sensor.symbol }}_{{ role | upper }}_BIT    {{ pin.bit }}
{%- if role in sensor.adc_channels %}
#define {{ sensor.symbol }}_{{ role | upper }}_ADC_CHANNEL {{ sensor.adc_channels[role] }}
{%- endif %}
{%- endfor %}
#define {{ sensor.symbol }}_REQUIRED {{ 1 if sensor.required else 0 }}
{% endfor %}
#endif /* CONFIG_H */
