{
  "openapi": "3.0.3",
  "info": {
    "title": "fw-automation-agent API",
    "version": "0.1.0",
    "description": "REST API for submitting hardware configurations and retrieving generated firmware artifacts."
  },
  "servers": [
    { "url": "http://localhost:8000/v1", "description": "Local development" }
  ],
  "paths": {
    "/requests": {
      "post": {
        "summary": "Submit a new firmware generation request",
        "operationId": "createRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HardwareConfig" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RequestAccepted" }
              }
            }
          }
        }
      }
    },
    "/requests/{requestId}/status": {
      "get": {
        "summary": "Get pipeline status for a request",
        "operationId": "getRequestStatus",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RequestStatus" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HardwareConfig": {
        "type": "object",
        "required": ["mcu"],
        "properties": {
          "mcu": { "type": "string", "example": "STM32F405RGT6" },
          "sensors": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "RequestAccepted": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" }
        }
      },
      "RequestStatus": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["DISCOVERY", "DESIGN", "CODEGEN", "TEST", "DEPLOY", "COMPLETE"]
          },
          "status": { "type": "string" }
        }
      }
    }
  }
}
