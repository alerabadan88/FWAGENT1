(export (version "E")
  (design
    (source "arduino-uno-sensors.kicad_sch")
    (tool "Eeschema 8.0.1"))
  (components
    (comp (ref "U1")
      (value "ATmega328P-PU")
      (footprint "Package_DIP:DIP-28_W7.62mm")
      (libsource (lib "MCU_Microchip_ATmega") (part "ATmega328P-PU")))
    (comp (ref "U2")
      (value "DHT22")
      (footprint "Sensor:DHT22")
      (libsource (lib "Sensor") (part "DHT22")))
    (comp (ref "U3")
      (value "HC-SR04")
      (footprint "Sensor_Distance:HC-SR04")
      (libsource (lib "Sensor_Distance") (part "HC-SR04")))
    (comp (ref "R1")
      (value "10k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (libsource (lib "Device") (part "R")))
    (comp (ref "R2")
      (value "LDR 5528")
      (footprint "Resistor_THT:R_LDR_5.1x4.3mm")
      (libsource (lib "Device") (part "R_PHOTO")))
    (comp (ref "R3")
      (value "10k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (libsource (lib "Device") (part "R")))
    (comp (ref "C1")
      (value "100nF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (libsource (lib "Device") (part "C"))))
  (nets
    (net (code "1") (name "GND")
      (node (ref "U1") (pin "8") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U1") (pin "22") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U2") (pin "4") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U3") (pin "4") (pinfunction "GND") (pintype "power_in"))
      (node (ref "R3") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C1") (pin "2") (pinfunction "~") (pintype "passive")))
    (net (code "2") (name "+5V")
      (node (ref "U1") (pin "7") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "U1") (pin "20") (pinfunction "AVCC") (pintype "power_in"))
      (node (ref "U2") (pin "1") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "U3") (pin "1") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "R1") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "R2") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "C1") (pin "1") (pinfunction "~") (pintype "passive")))
    (net (code "3") (name "/DHT_DATA")
      (node (ref "U1") (pin "4") (pinfunction "PD2") (pintype "bidirectional"))
      (node (ref "U2") (pin "2") (pinfunction "DATA") (pintype "bidirectional"))
      (node (ref "R1") (pin "1") (pinfunction "~") (pintype "passive")))
    (net (code "4") (name "/SONAR_TRIG")
      (node (ref "U1") (pin "15") (pinfunction "PB1") (pintype "bidirectional"))
      (node (ref "U3") (pin "2") (pinfunction "TRIG") (pintype "input")))
    (net (code "5") (name "/SONAR_ECHO")
      (node (ref "U1") (pin "16") (pinfunction "PB2") (pintype "bidirectional"))
      (node (ref "U3") (pin "3") (pinfunction "ECHO") (pintype "output")))
    (net (code "6") (name "/LIGHT_SENSE")
      (node (ref "U1") (pin "23") (pinfunction "PC0") (pintype "bidirectional"))
      (node (ref "R2") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "R3") (pin "1") (pinfunction "~") (pintype "passive")))))
